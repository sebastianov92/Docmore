# Variables read by docker-compose.yml. Copy to .env next to it.
APP_URL=http://localhost:3000
PORT=3000
# openssl rand -hex 32
APP_SECRET=
POSTGRES_PASSWORD=
MAIL_FROM_NAME=Docmore
# Page search engine: typesense (default, its own container) or database
SEARCH_DRIVER=typesense
# Only reachable inside the compose network; change it anyway
TYPESENSE_API_KEY=docmore-typesense
# Language of most pages, for word splitting (en, es, de, ja, zh...)
TYPESENSE_LOCALE=en
