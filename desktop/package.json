{
  "name": "docmore-desktop",
  "productName": "Docmore",
  "version": "0.1.0",
  "description": "Docmore in its own window: your server, native notifications, shortcuts.",
  "main": "main.js",
  "private": true,
  "license": "AGPL-3.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "^39.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.dezik.docmore",
    "productName": "Docmore",
    "files": ["main.js", "preload.js", "pick-server.html", "icons/**"],
    "directories": { "output": "dist" },
    "mac": { "category": "public.app-category.productivity", "icon": "icons/icon.png", "target": ["dmg", "zip"] },
    "win": { "icon": "icons/icon.png", "target": ["nsis"] },
    "linux": { "icon": "icons/icon.png", "category": "Office", "target": ["AppImage", "deb"] },
    "protocols": [{ "name": "Docmore", "schemes": ["docmore"] }]
  }
}
