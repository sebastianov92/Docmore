{
  "sourceLanguage": "en",
  "strings": {
    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docmore records the sound of the other participants (system audio) when you record a meeting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docmore graba el sonido de los demás participantes (audio del sistema) cuando grabas una reunión."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docmore uses the camera only when a page asks to capture a photo or video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docmore usa la cámara solo cuando una página pide capturar una foto o un video."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docmore can ask for Touch ID to unlock the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docmore puede pedir Touch ID para desbloquear la app."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docmore connects to your Docmore server on the local network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docmore se conecta a tu servidor Docmore en la red local."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docmore records your microphone when you record a meeting or attach a voice note."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Docmore graba tu micrófono cuando grabas una reunión o adjuntas una nota de voz."
          }
        }
      }
    }
  },
  "version": "1.0"
}
